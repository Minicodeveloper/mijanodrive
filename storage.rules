rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Regla para la carpeta de pasajeros (DNI y verificación)
    match /passengers/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Regla para la carpeta de conductores
    match /drivers/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Regla para las fotos de perfil sueltas
    match /profile_images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regla para la carpeta de publicidad (ads)
    match /ads/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regla para el comprobante de pago de planes
    match /plan_receipts/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Regla para la configuración y el QR de pago
    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
