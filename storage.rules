rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isStaff() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '').lower() in ['admin', 'superadmin', 'operator', 'operador', 'gerente'];
    }

    function isSuperAdmin() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '').lower() in ['admin', 'superadmin'];
    }

    match /drivers/{userId}/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuth() && request.auth.uid == userId;
    }

    match /profile_images/{userId}/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuth() && request.auth.uid == userId;
    }

    match /ads/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth() && isStaff()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /plan_receipts/{userId}/{fileName} {
      allow read: if isAuth() && (request.auth.uid == userId || isStaff());
      allow write: if isAuth() && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /settings/payment_qr/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth() && isSuperAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
