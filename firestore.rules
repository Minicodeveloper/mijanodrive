rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // FUNCIONES AUXILIARES
    // =====================================================================

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return exists(userDoc());
    }

    function getUserData() {
      return get(userDoc()).data;
    }

    function getRole() {
      return hasUserDoc() ? getUserData().get('role', '').lower() : '';
    }

    function isSuperAdmin() {
      return isAuth() && getRole() in ['admin', 'superadmin'];
    }

    function isManager() {
      return isAuth() && getRole() in ['operator', 'operador', 'gerente'];
    }

    function isSupport() {
      return isAuth() && getRole() in ['support', 'soporte'];
    }

    function isControl() {
      return isAuth() && getRole() == 'control';
    }

    function isStaff() {
      return isSuperAdmin() || isManager() || isSupport() || isControl();
    }

    function isAppUser() {
      return isAuth() && getRole() in ['passenger', 'pasajero', 'driver'];
    }

    function isApprovedDriver() {
      return hasUserDoc()
             && getRole() == 'driver'
             && (getUserData().get('status', '') == 'approved' || getUserData().get('isApproved', false) == true);
    }

    // =====================================================================
    // REGLAS POR COLECCIÓN
    // =====================================================================

    // 1. USUARIOS (USERS)
    match /users/{userId} {
      allow read: if isStaff() || request.auth.uid == userId;

      allow create: if isSuperAdmin() || (
        request.auth.uid == userId
        && request.resource.data.get('role', '').lower() in ['passenger', 'pasajero', 'driver']
        && (
          (request.resource.data.get('role', '').lower() == 'driver'
           && request.resource.data.get('status', '') == 'pending'
           && request.resource.data.get('isApproved', false) == false)
          ||
          (request.resource.data.get('role', '').lower() in ['passenger', 'pasajero']
           && request.resource.data.get('status', 'approved') == 'approved'
           && request.resource.data.get('isBlocked', false) == false)
        )
      );

      allow update: if isSuperAdmin() || (
        (isManager() || isControl())
        && resource.data.get('role', '').lower() in ['passenger', 'pasajero', 'driver']
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBlocked','isApproved','isRejected','isReported','status','documents'])
      ) || (
        request.auth.uid == userId
        && request.resource.data.get('isBlocked', false) == resource.data.get('isBlocked', false)
        && request.resource.data.get('isApproved', false) == resource.data.get('isApproved', false)
        && request.resource.data.get('isRejected', false) == resource.data.get('isRejected', false)
        && request.resource.data.get('isReported', false) == resource.data.get('isReported', false)
        && (
          (request.resource.data.get('role', '') == resource.data.get('role', '')
           && request.resource.data.get('status', 'approved') == resource.data.get('status', 'approved'))
          ||
          (
            request.resource.data.get('role', '').lower() in ['passenger', 'pasajero', 'driver']
            && (
              (request.resource.data.get('role', '').lower() == 'driver'
               && request.resource.data.get('status', '') == 'pending'
               && request.resource.data.get('isApproved', false) == false)
              ||
              (request.resource.data.get('role', '').lower() in ['passenger', 'pasajero']
               && request.resource.data.get('status', 'approved') == 'approved')
            )
          )
        )
      );

      allow delete: if isSuperAdmin();
    }

    // 2. CONDUCTORES (DRIVERS)
    match /drivers/{driverId} {
      allow read: if isAuth();

      allow create: if isStaff() || (
        request.auth.uid == driverId
        && (!('isBlocked' in request.resource.data) || request.resource.data.isBlocked == get(/databases/$(database)/documents/users/$(driverId)).data.get('isBlocked', false))
        && (!('isApproved' in request.resource.data) || request.resource.data.isApproved == get(/databases/$(database)/documents/users/$(driverId)).data.get('isApproved', false))
        && (!('status' in request.resource.data) || request.resource.data.status == get(/databases/$(database)/documents/users/$(driverId)).data.get('status', 'pending'))
        && (!('isAvailable' in request.resource.data) || request.resource.data.isAvailable == false)
        && (!('planPaymentStatus' in request.resource.data) || request.resource.data.planPaymentStatus == 'pending')
        && !('planExpiresAt' in request.resource.data)
      );

      allow update: if isStaff() || (
        request.auth.uid == driverId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBlocked', 'isApproved', 'status'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['planExpiresAt', 'activePlanId'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAvailable'])
            || request.resource.data.isAvailable == false
            || (
              resource.data.get('planPaymentStatus', '') == 'active'
              && resource.data.get('planExpiresAt', request.time) is timestamp
              && resource.data.planExpiresAt > request.time
            ))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['planPaymentStatus'])
            || request.resource.data.planPaymentStatus == 'pending')
      );

      allow delete: if isSuperAdmin();
    }

    // 3. VIAJES Y RESERVAS (TRIPS & RESERVATIONS)
    match /trips/{tripId} {
      allow read: if isStaff()
                  || resource.data.get('passengerId', '') == request.auth.uid
                  || resource.data.get('driverId', '') == request.auth.uid
                  || (resource.data.get('status', '') == 'pending' && isApprovedDriver());

      allow create: if request.auth.uid == request.resource.data.get('passengerId', '');

      allow update: if isStaff() || (
        request.resource.data.get('passengerId', '') == resource.data.get('passengerId', '')
        && request.resource.data.get('fareAmount', 0) == resource.data.get('fareAmount', 0)
        && (
          request.auth.uid == resource.data.get('passengerId', '')
          ||
          (resource.data.get('status', '') == 'pending'
           && request.resource.data.get('driverId', '') == request.auth.uid
           && isApprovedDriver())
          ||
          (resource.data.get('driverId', '') == request.auth.uid
           && request.resource.data.get('driverId', '') == resource.data.get('driverId', ''))
        )
      );
      allow delete: if isSuperAdmin();

      match /messages/{msgId} {
        allow read, write: if isStaff()
                           || get(/databases/$(database)/documents/trips/$(tripId)).data.get('passengerId', '') == request.auth.uid
                           || get(/databases/$(database)/documents/trips/$(tripId)).data.get('driverId', '') == request.auth.uid;
      }
    }

    match /reservations/{resId} {
      allow read: if isStaff()
                  || resource.data.get('passengerId', '') == request.auth.uid
                  || resource.data.get('driverId', '') == request.auth.uid
                  || (resource.data.get('status', '') == 'pending' && isApprovedDriver());
      allow create: if request.auth.uid == request.resource.data.get('passengerId', '');
      allow update: if isStaff() || (
        request.resource.data.get('passengerId', '') == resource.data.get('passengerId', '')
        && request.resource.data.get('fareAmount', 0) == resource.data.get('fareAmount', 0)
        && (
             request.auth.uid == resource.data.get('passengerId', '')
          || (resource.data.get('status', '') == 'pending'
              && request.resource.data.get('driverId', '') == request.auth.uid
              && isApprovedDriver())
          || (resource.data.get('driverId', '') == request.auth.uid
              && request.resource.data.get('driverId', '') == resource.data.get('driverId', ''))
        )
      );
      allow delete: if isSuperAdmin();
    }

    // 4. DINERO (WALLETS & TRANSACTIONS)
    match /wallets/{walletId} {
      allow read: if isSuperAdmin() || request.auth.uid == walletId;
      allow create: if isSuperAdmin() || (request.auth.uid == walletId && (request.resource.data.balance == 0 || request.resource.data.balance == 0.0));
      allow update, delete: if isSuperAdmin();
    }

    match /transactions/{txId} {
      allow read: if isSuperAdmin() || resource.data.get('walletId', '') == request.auth.uid;
      allow write: if isSuperAdmin();
    }

    // 5. CONFIGURACIÓN (SETTINGS & CITIES)
    match /settings/{docId} {
      allow read: if isSuperAdmin()
                  || (isAuth() && !isStaff() && docId == 'pricing')
                  || (isAuth() && docId == 'payment_qr');
      allow write: if isSuperAdmin();
    }

    match /cities/{cityId} {
      allow read: if isAuth() && !isStaff();
      allow write: if isSuperAdmin();
    }

    // 6. COMUNICACIÓN Y MODERACIÓN
    match /support_chats/{chatId} {
      allow read, write: if isStaff() || request.auth.uid == chatId;
      match /messages/{msgId} {
        allow read, write: if isStaff() || request.auth.uid == chatId;
      }
    }

    match /reports/{reportId} {
      allow create: if isAuth();
      allow read, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    match /alerts/{alertId} {
      allow create: if isAuth() && request.resource.data.get('status', '') == 'open';
      allow read, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isStaff() || resource.data.get('userId', '') == request.auth.uid;
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
      );
    }

    // 7. PUBLICIDAD Y PLANES
    match /ads/{adId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin() || isManager();
    }

    match /plans/{planId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin()
                   && request.resource.data.get('price', 0) is number
                   && request.resource.data.get('price', 0) > 0
                   && request.resource.data.get('durationDays', 0) is number
                   && request.resource.data.get('durationDays', 0) > 0
                   && request.resource.data.get('benefits', []) is list
                   && request.resource.data.get('name', '') is string;
    }

    match /plan_requests/{reqId} {
      allow create: if isApprovedDriver()
                    && request.resource.data.get('driverId', '') == request.auth.uid
                    && request.resource.data.get('status', '') == 'pending'
                    && request.resource.data.get('planId', '') != ''
                    && exists(/databases/$(database)/documents/plans/$(request.resource.data.planId))
                    && request.resource.data.get('amount', 0) > 0
                    && request.resource.data.get('days', 0) > 0
                    && request.resource.data.get('receiptUrl', '') is string
                    && request.resource.data.get('receiptUrl', '') != '';
      allow read: if isSuperAdmin() || isManager() || resource.data.get('driverId', '') == request.auth.uid;
      allow update: if isSuperAdmin() || isManager();
      allow delete: if isSuperAdmin();
    }

    match /driver_plans/{driverId} {
      allow read: if isSuperAdmin() || isManager() || request.auth.uid == driverId;
      allow write: if isSuperAdmin() || isManager();
    }
  }
}
