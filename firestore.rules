rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // FUNCIONES AUXILIARES
    // =====================================================================

    // Verifica si el usuario ha iniciado sesión
    function isAuth() {
      return request.auth != null;
    }

    // Construye la ruta al documento del usuario
    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Verifica si el documento de usuario existe antes de leerlo
    function hasUserDoc() {
      return exists(userDoc());
    }

    // Obtiene los datos del documento del usuario de forma segura
    function getUserData() {
      return get(userDoc()).data;
    }

    // Obtiene el rol normalizado, manejando documentos que aún no existen
    function getRole() {
      return hasUserDoc() ? getUserData().get('role', '').lower() : '';
    }

    // Verifica los niveles de acceso del Staff
    function isSuperAdmin() {
      return isAuth() && getRole() in ['admin', 'superadmin'];
    }

    function isManager() {
      return isAuth() && getRole() in ['operator', 'operador', 'gerente'];
    }

    function isSupport() {
      return isAuth() && getRole() in ['support', 'soporte'];
    }

    function isControl() {
      return isAuth() && getRole() == 'control';
    }

    function isStaff() {
      return isSuperAdmin() || isManager() || isSupport() || isControl();
    }

    function isAppUser() {
      return isAuth() && getRole() in ['passenger', 'pasajero', 'driver'];
    }

    // Verifica que un conductor esté totalmente aprobado (y exista)
    function isApprovedDriver() {
      return hasUserDoc()
             && getRole() == 'driver'
             && (getUserData().get('status', '') == 'approved' || getUserData().get('isApproved', false) == true);
    }

    // =====================================================================
    // REGLAS POR COLECCIÓN
    // =====================================================================

    // 1. USUARIOS (USERS)
    match /users/{userId} {
      allow read: if isStaff() || request.auth.uid == userId;

      allow create: if isSuperAdmin() || (
        request.auth.uid == userId
        && request.resource.data.get('role', '').lower() in ['passenger', 'pasajero', 'driver']
        && (
          (request.resource.data.get('role', '').lower() == 'driver'
           && request.resource.data.get('status', '') == 'pending'
           && request.resource.data.get('isApproved', false) == false)
          ||
          (request.resource.data.get('role', '').lower() in ['passenger', 'pasajero']
           && request.resource.data.get('status', 'approved') == 'approved'
           && request.resource.data.get('isBlocked', false) == false)
        )
      );

      allow update: if isSuperAdmin() || (
        // El gerente o control pueden editar a clientes sin cambiarles el rol, solo campos de moderación
        (isManager() || isControl())
        && resource.data.get('role', '').lower() in ['passenger', 'pasajero', 'driver']
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBlocked','isApproved','isRejected','isReported','status','documents'])
      ) || (
        // El propio usuario se edita
        request.auth.uid == userId
        // Bloqueo de escalada de privilegios
        && request.resource.data.get('isBlocked', false) == resource.data.get('isBlocked', false)
        && request.resource.data.get('isApproved', false) == resource.data.get('isApproved', false)
        && request.resource.data.get('isRejected', false) == resource.data.get('isRejected', false)
        && request.resource.data.get('isReported', false) == resource.data.get('isReported', false)
        && (
          // CASO A: Actualiza su perfil sin cambiar de rol (el saveUser normal)
          (request.resource.data.get('role', '') == resource.data.get('role', '')
           && request.resource.data.get('status', 'approved') == resource.data.get('status', 'approved'))
          ||
          // CASO B: Cambia su rol en el ProfileSetupScreen (ej: de passenger a driver)
          (
            request.resource.data.get('role', '').lower() in ['passenger', 'pasajero', 'driver']
            && (
              (request.resource.data.get('role', '').lower() == 'driver'
               && request.resource.data.get('status', '') == 'pending'
               && request.resource.data.get('isApproved', false) == false)
              ||
              (request.resource.data.get('role', '').lower() in ['passenger', 'pasajero']
               && request.resource.data.get('status', 'approved') == 'approved')
            )
          )
        )
      );

      allow delete: if isSuperAdmin();
    }

    // 2. CONDUCTORES (DRIVERS) - Copia pública / GPS
    match /drivers/{driverId} {
      allow read: if isAuth();

      // La primera vez que el conductor se sincrónica a sí mismo en drivers (set con merge)
      allow create: if isStaff() || (
        request.auth.uid == driverId
        // Valida los campos protegidos SOLO si vienen en el payload
        && (!('isBlocked' in request.resource.data) || request.resource.data.isBlocked == get(/databases/$(database)/documents/users/$(driverId)).data.get('isBlocked', false))
        && (!('isApproved' in request.resource.data) || request.resource.data.isApproved == get(/databases/$(database)/documents/users/$(driverId)).data.get('isApproved', false))
        && (!('status' in request.resource.data) || request.resource.data.status == get(/databases/$(database)/documents/users/$(driverId)).data.get('status', 'pending'))
        && (!('isAvailable' in request.resource.data) || request.resource.data.isAvailable == false)
        && (!('planPaymentStatus' in request.resource.data) || request.resource.data.planPaymentStatus == 'pending')
        && !('planExpiresAt' in request.resource.data)
      );

      // Cuando actualiza su GPS, disponibilidad, etc.
      allow update: if isStaff() || (
        request.auth.uid == driverId
        // Impide que el propio conductor modifique sus campos de acceso
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBlocked', 'isApproved', 'status'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['planExpiresAt', 'activePlanId'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAvailable'])
            || request.resource.data.isAvailable == false
            || (
              resource.data.get('planPaymentStatus', '') == 'active'
              && resource.data.get('planExpiresAt', request.time) is timestamp
              && resource.data.planExpiresAt > request.time
            ))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['planPaymentStatus'])
            || request.resource.data.planPaymentStatus == 'pending')
      );

      allow delete: if isSuperAdmin();
    }

    // 3. COMPROBANTES DE PLANES PARA CONDUCTORES
    match /driver_plan_payments/{paymentId} {
      allow create: if isApprovedDriver()
                    && request.resource.data.keys().hasAll([
                      'driverId', 'driverName', 'vehiclePlate',
                      'planId', 'planName', 'amount',
                      'durationDays', 'receiptUrl', 'notes', 'status', 'createdAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'driverId', 'driverName', 'vehiclePlate',
                      'planId', 'planName', 'amount',
                      'durationDays', 'receiptUrl', 'notes', 'status', 'createdAt'
                    ])
                    && request.resource.data.get('driverId', '') == request.auth.uid
                    && request.resource.data.get('driverName', '') is string
                    && request.resource.data.get('vehiclePlate', '') is string
                    && request.resource.data.get('status', '') == 'pending'
                    && request.resource.data.get('createdAt', null) == request.time
                    && request.resource.data.get('receiptUrl', '') is string
                    && request.resource.data.get('receiptUrl', '') != ''
                    && request.resource.data.get('notes', '') is string
                    && request.resource.data.get('notes', '').size() <= 240
                    && (
                      (request.resource.data.get('planId', '') == 'daily'
                       && request.resource.data.get('planName', '') == 'Plan diario'
                       && request.resource.data.get('amount', 0) == 2.5
                       && request.resource.data.get('durationDays', 0) == 1)
                      ||
                      (request.resource.data.get('planId', '') == 'weekly'
                       && request.resource.data.get('planName', '') == 'Plan semanal'
                       && request.resource.data.get('amount', 0) == 15
                       && request.resource.data.get('durationDays', 0) == 7)
                      ||
                      (request.resource.data.get('planId', '') == 'monthly'
                       && request.resource.data.get('planName', '') == 'Plan mensual'
                       && request.resource.data.get('amount', 0) == 50
                       && request.resource.data.get('durationDays', 0) == 30)
                    );
      allow read: if isSuperAdmin()
                  || resource.data.get('driverId', '') == request.auth.uid;
      allow update: if isSuperAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'reviewedAt'])
                    && request.resource.data.get('status', '') in ['approved', 'rejected'];
      allow delete: if isSuperAdmin();
    }

    // 4. VIAJES Y RESERVAS (TRIPS & RESERVATIONS)
    match /trips/{tripId} {
      allow read: if isStaff()
                  || resource.data.get('passengerId', '') == request.auth.uid
                  || resource.data.get('driverId', '') == request.auth.uid
                  || (resource.data.get('status', '') == 'pending' && isApprovedDriver());

      allow create: if request.auth.uid == request.resource.data.get('passengerId', '');

      allow update: if isStaff() || (
        // Bloqueo: Nadie puede alterar los IDs del pasajero o la tarifa. Se usa un default 0 por seguridad.
        request.resource.data.get('passengerId', '') == resource.data.get('passengerId', '')
        && request.resource.data.get('fareAmount', 0) == resource.data.get('fareAmount', 0)
        && (
          // El pasajero puede cancelar/actualizar
          request.auth.uid == resource.data.get('passengerId', '')
          ||
          // El conductor lo acepta por primera vez (se requiere estar APROBADO)
          (resource.data.get('status', '') == 'pending'
           && request.resource.data.get('driverId', '') == request.auth.uid
           && isApprovedDriver())
          ||
          // El conductor asignado reporta avance o llegada
          (resource.data.get('driverId', '') == request.auth.uid
           && request.resource.data.get('driverId', '') == resource.data.get('driverId', ''))
        )
      );
      allow delete: if isSuperAdmin();

      // Chat interno del viaje
      match /messages/{msgId} {
        allow read, write: if isStaff()
                           || get(/databases/$(database)/documents/trips/$(tripId)).data.get('passengerId', '') == request.auth.uid
                           || get(/databases/$(database)/documents/trips/$(tripId)).data.get('driverId', '') == request.auth.uid;
      }
    }

    match /reservations/{resId} {
      allow read: if isStaff()
                  || resource.data.get('passengerId', '') == request.auth.uid
                  || resource.data.get('driverId', '') == request.auth.uid
                  || (resource.data.get('status', '') == 'pending' && isApprovedDriver());
      allow create: if request.auth.uid == request.resource.data.get('passengerId', '');
      allow update: if isStaff() || (
        request.resource.data.get('passengerId', '') == resource.data.get('passengerId', '')
        && request.resource.data.get('fareAmount', 0) == resource.data.get('fareAmount', 0)
        && (
             request.auth.uid == resource.data.get('passengerId', '')
          || (resource.data.get('status', '') == 'pending'
              && request.resource.data.get('driverId', '') == request.auth.uid
              && isApprovedDriver())
          || (resource.data.get('driverId', '') == request.auth.uid
              && request.resource.data.get('driverId', '') == resource.data.get('driverId', ''))
        )
      );
      allow delete: if isSuperAdmin();
    }

    // 5. DINERO (WALLETS & TRANSACTIONS)
    match /wallets/{walletId} {
      allow read: if isSuperAdmin() || request.auth.uid == walletId;
      // Solo el dueño puede crear su propia billetera e inicializada en 0/0.0
      allow create: if isSuperAdmin() || (request.auth.uid == walletId && (request.resource.data.balance == 0 || request.resource.data.balance == 0.0));
      allow update, delete: if isSuperAdmin();
    }

    match /transactions/{txId} {
      allow read: if isSuperAdmin() || resource.data.get('walletId', '') == request.auth.uid;
      allow write: if isSuperAdmin();
    }

    // 6. CONFIGURACIÓN (SETTINGS & CITIES)
    match /settings/{docId} {
      // El gerente, control o soporte nunca leen settings (para evitar acceso a pricing).
      allow read: if isSuperAdmin() || (isAuth() && !isStaff() && docId == 'pricing');
      allow write: if isSuperAdmin();
    }

    match /cities/{cityId} {
      // Usado para ver la tarifa urbana en search_trip_screen.
      allow read: if isAuth() && !isStaff();
      allow write: if isSuperAdmin();
    }

    // 6. COMUNICACIÓN Y MODERACIÓN (SOPORTE, REPORTES, S.O.S., NOTIFICACIONES)
    match /support_chats/{chatId} {
      allow read, write: if isStaff() || request.auth.uid == chatId;
      match /messages/{msgId} {
        allow read, write: if isStaff() || request.auth.uid == chatId;
      }
    }

    match /reports/{reportId} {
      allow create: if isAuth();
      allow read, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    match /alerts/{alertId} {
      allow create: if isAuth() && request.resource.data.get('status', '') == 'open';
      allow read, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isStaff() || resource.data.get('userId', '') == request.auth.uid;
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
      );
    }

    // 8. PUBLICIDAD Y PLANES
    match /ads/{adId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin() || isManager();
    }

    match /plans/{planId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    match /plan_requests/{reqId} {
      allow create: if isApprovedDriver()
                    && request.resource.data.get('driverId', '') == request.auth.uid
                    && request.resource.data.get('status', '') == 'pending';
      allow read: if isSuperAdmin() || isManager() || resource.data.get('driverId', '') == request.auth.uid;
      allow update: if isSuperAdmin() || isManager();
      allow delete: if isSuperAdmin();
    }

    match /driver_plans/{driverId} {
      allow read: if isSuperAdmin() || isManager() || request.auth.uid == driverId;
      allow write: if isSuperAdmin() || isManager();
    }
  }
}